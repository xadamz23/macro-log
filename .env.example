# Registry the images are pushed to / pulled from (e.g. ghcr.io/your-user)
REGISTRY=ghcr.io/your-user
TAG=latest
APP_PORT=8003
# Host interface the app port is published on. Keep 127.0.0.1 when cloudflared runs on this host;
# only use 0.0.0.0 if the tunnel runs elsewhere AND the CF_ACCESS_* check below is enabled.
APP_BIND=127.0.0.1

# Postgres (use a URL-safe password: letters, digits, - and _)
POSTGRES_USER=macrolog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=macrolog

# Default timezone until changed in Settings
APP_TZ=America/Chicago

# Cloudflare Access (leave blank to disable the in-app JWT check)
# Team domain like yourteam.cloudflareaccess.com; AUD tag from the Access application
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
